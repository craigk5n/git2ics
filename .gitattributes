# Normalise line endings in the repository. Note this does not affect the
# generated .ics, which always uses CRLF as RFC 5545 requires — that is written
# by the code, not by git.
* text=auto eol=lf

*.php text diff=php
*.md text
*.yml text
*.json text
*.neon text
*.xml text

# Golden .ics fixtures are CRLF by definition; never let git rewrite them.
*.ics -text

bin/git2ics text eol=lf

# Keep the Composer dist tarball to just what is needed at runtime. Without
# this, `composer require` ships the entire test suite and CI config to every
# consumer.
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.github            export-ignore
/.php-cs-fixer.dist.php export-ignore
/box.json           export-ignore
/infection.json5    export-ignore
/phpstan.neon       export-ignore
/phpunit.xml        export-ignore
/psalm.xml          export-ignore
/tests              export-ignore
/CHANGELOG.md       export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md    export-ignore
/SECURITY.md        export-ignore
